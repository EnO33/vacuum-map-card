.claude/private-patterns.local.txt
.tmp/
.worktrees/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.pnpm-store/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
