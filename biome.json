{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "!scripts/test-hooks.mjs",
      "!**/*.md",
      "!src/domain/text/case-fold-table.ts",
      "!test/fixtures/synthetic/casefold-vectors.json",
      "*.ts",
      "*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app",
                      "**/app/**",
                      "**/adapters",
                      "**/adapters/**",
                      "**/ui",
                      "**/ui/**",
                      "**/index",
                      "**/i18n",
                      "**/i18n/**",
                      "lit",
                      "lit/**"
                    ],
                    "message": "The domain imports nothing from app, adapters, ui or Lit (CLAUDE.md « Architecture »)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/adapters",
                      "**/adapters/**",
                      "**/ui",
                      "**/ui/**",
                      "**/index",
                      "**/i18n",
                      "**/i18n/**",
                      "lit",
                      "lit/**"
                    ],
                    "message": "The app layer imports only the domain and its own files (CLAUDE.md « Architecture »)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
